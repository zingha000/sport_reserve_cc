FLASK_APP=run.py
FLASK_DEBUG=True
SECRET_KEY=change-this-secret-key

# Aplikasi: gunakan hostname pooled dengan akhiran -pooler.
DATABASE_URL=postgresql://username:password@host-pooler/database
# Migrasi/skrip administratif: koneksi langsung tanpa pooler.
DATABASE_URL_DIRECT=postgresql://username:password@host/database

DB_POOL_MAX=5
DB_LOCK_TIMEOUT=3s
DB_STATEMENT_TIMEOUT=10s

# Neon Object Storage (S3-compatible).
AWS_ENDPOINT_URL_S3=https://change-this-endpoint
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=change-this-access-key
AWS_SECRET_ACCESS_KEY=change-this-secret-key
S3_BUCKET=change-this-bucket
